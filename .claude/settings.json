{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-guard.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Checking eval-gate protection"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-guard.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Scanning staged changes for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-effect-check.sh",
            "args": [],
            "timeout": 120,
            "statusMessage": "Checking whether a gate file changed"
          }
        ]
      }
    ]
  }
}

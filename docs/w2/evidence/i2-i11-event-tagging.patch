+    def test_a_fhir_read_carries_the_turns_use_case_and_key(
+        self, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """Eval I2/I11: every event of a turn is attributable, its FHIR reads included."""
+        import httpx
+
+        from app.fhir import client as fhir_client
+        from app.models.metrics_events import UseCase
+
+        real_client = httpx.AsyncClient
+
+        def handler(request: httpx.Request) -> httpx.Response:
+            if request.url.path.endswith("/Patient/p-1"):
+                return httpx.Response(200, json={"resourceType": "Patient", "id": "p-1"})
+            return httpx.Response(200, json={"resourceType": "Bundle", "entry": []})
+
+        monkeypatch.setattr(
+            fhir_client.httpx,
+            "AsyncClient",
+            lambda **_: real_client(transport=httpx.MockTransport(handler)),
+        )
+        tags = {"use_case": UseCase.FOLLOW_UP_DRILLING, "patient_session_key": "key-1"}
+
+        async def turn() -> None:
+            await fhir_client.ensure_patient_exists("token", "p-1", **tags)
+            await fhir_client.get_conditions("token", "p-1", **tags)
+
+        with capture_logs() as logs:
+            asyncio.run(turn())
+        calls = _events(logs, "tool_call_event")
+        assert [c["event_data"]["target"] for c in calls] == ["Patient", "Condition"]
+        assert {(c["use_case"], c["patient_session_key"]) for c in calls} == {
+            ("follow_up_drilling", "key-1")
+        }
+
     def test_a_writeback_is_a_step_and_a_tool_call(self) -> None:
         with capture_logs() as logs:
             post_writeback(200, None)

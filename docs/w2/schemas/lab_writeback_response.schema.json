{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-copilot.invalid/schemas/w2-contracts/lab_writeback_response/1.0.0",
  "title": "LabWriteBackResponse",
  "$defs": {
    "LabWriteBackResultOutcome": {
      "additionalProperties": false,
      "description": "What happened to one result, with the ids D1 requires the endpoint to\nreturn. Real ids, not `true`: the standard document endpoint's\nreturns-no-identifier behaviour is the race D1 exists to fix.",
      "properties": {
        "test_code": {
          "minLength": 1,
          "title": "Test Code",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "extraction_id": {
          "pattern": "^w2x-[0-9a-f]{32}$",
          "title": "Extraction Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/WriteOutcome"
        },
        "procedure_report_id": {
          "minimum": 1,
          "title": "Procedure Report Id",
          "type": "integer"
        },
        "procedure_result_id": {
          "minimum": 1,
          "title": "Procedure Result Id",
          "type": "integer"
        }
      },
      "required": [
        "test_code",
        "idempotency_key",
        "extraction_id",
        "outcome",
        "procedure_report_id",
        "procedure_result_id"
      ],
      "title": "LabWriteBackResultOutcome",
      "type": "object"
    },
    "WriteOutcome": {
      "description": "What the endpoint did with one result.",
      "enum": [
        "created",
        "duplicate_ignored"
      ],
      "title": "WriteOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The ids the endpoint wrote, or found already written.",
  "properties": {
    "patient_uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Patient Uuid",
      "type": "string"
    },
    "document_id": {
      "description": "`documents.id` of the stored file.",
      "minimum": 1,
      "title": "Document Id",
      "type": "integer"
    },
    "document_outcome": {
      "$ref": "#/$defs/WriteOutcome"
    },
    "procedure_order_id": {
      "minimum": 1,
      "title": "Procedure Order Id",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/LabWriteBackResultOutcome"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "correlation_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Correlation Id",
      "type": "string"
    }
  },
  "required": [
    "patient_uuid",
    "document_id",
    "document_outcome",
    "procedure_order_id",
    "results",
    "correlation_id"
  ],
  "type": "object"
}

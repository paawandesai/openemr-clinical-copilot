{
  "name": "openemr-patient-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React port of the OpenEMR patient dashboard, served with a same-origin OAuth BFF (work order 31).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:bff": "tsx watch bff/src/server.ts",
    "build": "npm run build:web && npm run build:bff",
    "build:web": "vite build",
    "build:bff": "tsc -p bff/tsconfig.json",
    "start": "node dist/bff/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p bff/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "scripts/e2e-local.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@playwright/test": "1.49",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "bootstrap": "4.6.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}

# Copy to your environment (never commit real values). See README.md.
PUBLIC_ORIGIN=http://localhost:8787
OPENEMR_OAUTH_BASE=https://localhost:9300/oauth2/default
# Only when the browser reaches OpenEMR at a different address than the BFF does (containers):
# OPENEMR_BROWSER_OAUTH_BASE=https://<public host>:9300/oauth2/default
# Only in a container reaching OpenEMR's CN=localhost certificate through host.docker.internal:
# OPENEMR_TLS_SERVERNAME=localhost
# OPENEMR_CA_FILE=/run/secrets/openemr_ca
# The `iss` the ID token must carry; defaults to OPENEMR_OAUTH_BASE (audit F-49).
OPENEMR_ISSUER=https://localhost:9300/oauth2/default
OPENEMR_FHIR_BASE=https://localhost:9300/apis/default/fhir
# Only when OpenEMR advertises a different FHIR URL than the one the BFF dials (containers):
# OPENEMR_FHIR_AUDIENCE=https://localhost:9300/apis/default/fhir
OAUTH_CLIENT_ID=
# A file holding the client secret (preferred), or OAUTH_CLIENT_SECRET.
OAUTH_CLIENT_SECRET_FILE=
STATIC_DIR=dist/web
PORT=8787
HOST=127.0.0.1
# OpenEMR's local self-signed certificate; never disable TLS verification instead.
NODE_EXTRA_CA_CERTS=

__pycache__/
*.pyc
.venv/
venv/

# evals/w2/factory writes generated documents here; the six committed sample
# scenarios under output/samples/ are the exception (evals/w2/factory/README.md).
evals/w2/factory/output/*
!evals/w2/factory/output/samples/

# Local-only compose override for the agent stack (docs/w2/LOCAL_ENV.md).
deploy/docker-compose.override.yml

# Dense-retrieval vectors, derived from corpus/chunks.json and rebuilt in
# seconds (app/retrieval/dense.py). Cached per (model, corpus fingerprint),
# so a stale cache cannot be read.
app/retrieval/corpus/.cache/

# The eval gate's judge cache. Generated per machine, keyed on (case, output, prompt text, model version);
# committing it would let a stale verdict outlive the thing that produced it.
evals/w2/.judge_cache/

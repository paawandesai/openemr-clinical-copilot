# The image needs only requirements.txt and app/ (see Dockerfile). Everything
# else stays out of the build context — above all any .env holding a key.
.env
.env.*
**/.env
**/.env.*
.venv/
venv/
logs/
**/__pycache__/
.pytest_cache/
.DS_Store
tests/
scripts/
docs/
deploy/
observability/
api-collection/

# The dense-vector cache is derived data keyed on (model, corpus hash). The
# Dockerfile builds a fresh one; copying the developer's in would ship a
# second, stale .npz alongside it and make the image depend on whatever
# state that machine happened to be in.
app/retrieval/corpus/.cache/

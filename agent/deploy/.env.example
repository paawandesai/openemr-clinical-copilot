# Format of the agent's env file. On the droplet: /etc/clinical-copilot/agent.env,
# mode 600, outside the code tree and outside any directory a web server
# serves (agent/docs/deployment.md). Locally, a .env next to this file also
# works (gitignored). Never commit a filled-in copy.

# Required. The agent's only credential. It holds no FHIR credentials: each
# request brings the clinician's own OpenEMR token (ARCHITECTURE.md §2).
ANTHROPIC_API_KEY=

# Required. The address clients use to reach the agent; the TLS certificate
# is issued for it. The droplet's public IPv4 address:
AGENT_PUBLIC_HOST=201.79.25.22

# Optional overrides (defaults shown).
# FHIR_BASE_URL=https://host.docker.internal:9300/apis/default/fhir
# FHIR_VERIFY_TLS=false

# Load-test only (agent/load-test/README.md). Leave unset/false always,
# except for the duration of an infra load test run: a stubbed claim is a
# verbatim copy of the source record, not a model's output.
# AGENT_STUB_LLM_DRAFTING=false

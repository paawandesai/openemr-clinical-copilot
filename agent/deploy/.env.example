# Format of the agent's env file. On the deployment host: /etc/clinical-copilot/agent.env,
# mode 600, outside the code tree and outside any directory a web server
# serves (agent/docs/deployment.md). Locally, a .env next to this file also
# works (gitignored). Never commit a filled-in copy.

# Required. The agent's only credential. It holds no FHIR credentials: each
# request brings the clinician's own OpenEMR token (ARCHITECTURE.md §2).
ANTHROPIC_API_KEY=

# Required. The address clients use to reach the agent; the TLS certificate
# is issued for it. The deployment host's public IPv4 address:
AGENT_PUBLIC_HOST=64.177.42.210

# Required. The key telemetry's patient_session_key is HMAC'd under, so no
# log line or Langfuse event carries a patient uuid (D56). At least 32
# characters; generate one with
#   python -c 'import secrets; print(secrets.token_hex(32))'
# The agent refuses to start without it in production (AGENT_ENV defaults to
# production in the image). Keep it stable across deploys: a new value starts
# new trace sessions, and the old ones no longer group with the new.
AGENT_TELEMETRY_HMAC_SECRET=

# Required. The AES-256-GCM key uploaded documents' extractions are sealed
# under on the extraction_data volume, so a restart does not forget them
# (D60). Exactly 64 hex characters; generate one with
#   python -c 'import secrets; print(secrets.token_hex(32))'
# The agent refuses to start without it in production. Keep it stable: a new
# key makes every saved extraction unreadable, and each such document must be
# uploaded again (the chart copy is unaffected).
AGENT_EXTRACTION_STORE_KEY=

# Optional overrides (defaults shown).
# FHIR_BASE_URL=https://host.docker.internal:9300/apis/default/fhir
# FHIR_VERIFY_TLS=false
# Anything but `production` allows a missing secret, falling back to a
# published dev default whose emitted keys start psk_dev_. Local stacks only.
# AGENT_ENV=production

# Load-test only (agent/load-test/README.md). Leave unset/false always,
# except for the duration of an infra load test run: a stubbed claim is a
# verbatim copy of the source record, not a model's output.
# AGENT_STUB_LLM_DRAFTING=false
